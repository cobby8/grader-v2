{
 "name": "럭비 저지 — 드롭숄더 · V넥 립 · 앞뒤 요크 · 립 커프스",
 "version": 2,
 "decisions": "2026-10-18~19 사장님 결정(output/rugby-jersey-pattern-20261016/결정기록_1018.md) ②③④⑤ 반영 2026-10-23 · ① V 인서트 2026-10-23(김현서 실측 높이 7·윗변 13·2겹·같은 원단). 10-16 초안 그대로는 rugby_jersey_1016.json",
 "source": "output/rugby-jersey-pattern-20261016/scripts/rugby_final.py (2026-10-16 최종 제도) 의 치수·수식을 그대로 옮김",
 "coords": "x 오른쪽 · y 아래쪽(+) · mm. 몸판·요크·소매는 반쪽을 그려 x=0 중심선으로 거울 펼침. 뒷목 중심 y=BND, 옆목점 y=0",
 "default_sa": "sa",
 "notch": {"type": "slit", "depth": 5.0},

 "inputs": {
  "length_cb":       {"label": "총길이(C.B)",                   "kind": "사이즈표"},
  "shoulder_width":  {"label": "어깨넓이(끝~끝)",               "kind": "사이즈표"},
  "chest":           {"label": "가슴둘레(= 가슴단면 × 2)",       "kind": "사이즈표"},
  "hem":             {"label": "밑단둘레(= 밑단단면 × 2)",       "kind": "사이즈표"},
  "sleeve_length":   {"label": "소매길이(어깨끝~커프스 끝)",     "kind": "사이즈표"},
  "cuff":            {"label": "소매입구 둘레(= 소매입구단면 × 2)", "kind": "사이즈표"},
  "armhole_depth":   {"label": "진동 깊이(어깨끝~겨드랑이 직선)", "kind": "실측"},
  "sleeve_width_25": {"label": "소매통(겨드랑이 2.5cm 아래 단면)", "kind": "실측"},
  "v_depth":         {"label": "V넥 깊이(옆목점~V 꼭짓점 직선)", "kind": "실측"},
  "yoke_back":       {"label": "요크 위치(뒷목~뒤 이음선)",      "kind": "실측"},
  "sleeve_hem":      {"label": "소매 밑단 둘레(커프스 달기 전)",  "kind": "실측"},
  "neck_width":      {"label": "목너비(옆목점 사이)",            "kind": "추정"},
  "back_neck_depth": {"label": "뒷목 깊이",                      "kind": "추정"},
  "shoulder_drop":   {"label": "어깨 처짐",                      "kind": "추정"},
  "cuff_height":     {"label": "커프스 높이(완성)",              "kind": "추정"},
  "rib_width":       {"label": "넥 립 폭(완성)",                 "kind": "추정"}
 },

 "params": {
  "sa": 10, "hem_sa": 25,
  "ease": 0.995,
  "ang_shoulder": 90, "ang_body_underarm": 105, "ang_sleeve_underarm": 83,
  "notch_arm_front": 0.461, "notch_arm_back1": 0.404, "notch_arm_back2": 0.464,
  "notch_cap_front": 0.461, "notch_cap_back1": 0.410, "notch_cap_back2": 0.472,
  "arm_c1": 0.55, "arm_c2": 0.12,
  "cap_c1": 0.40, "cap_c2": 0.30,
  "neck_c1_x": 50, "neck_c2_in": 8, "neck_c2_y": 12, "neck_c2_d": 15, "fn_c1": 0.45, "fn_c2": 30,
  "w25_drop": 25,
  "rib_front_ratio": 0.97, "rib_back_ratio": 0.92, "rib_inset": 0.35,
  "yoke_front_offset": 0,
  "insert_h": 70, "insert_top_w": 130
 },

 "vars": {
  "NW": "neck_width / 2",
  "BND": "back_neck_depth",
  "CH": "chest / 4",
  "HEM_X": "hem / 4",
  "HEM_Y": "length_cb + BND",
  "YOKE_Y": "BND + yoke_back",
  "YOKE_Y_F": "YOKE_Y + yoke_front_offset",
  "V_ALPHA": {"solve": "sin(V_ALPHA) - rib_width / dist(HPS, VT)", "lo": 0.01, "hi": 80, "iter": 60},
  "V_ANG": "angle(HPS, VT) - V_ALPHA",
  "V_PHI": "V_ANG - 90",
  "RIB_E": "rib_width * tan(V_PHI)",
  "INS_TOP_Y": "YOKE_Y_F - insert_h",
  "V_Y": "sqrt(v_depth*v_depth - NW*NW)",
  "SL": "sleeve_length - cuff_height",
  "HW": "sleeve_hem / 2",
  "TARGET": "length(ARM) * ease",
  "CAP_H": {"solve": "length(CAP) - TARGET", "lo": 5, "hi": 300, "iter": 80},
  "CAP_K": "w25_drop / (SL - CAP_H)",
  "CAP_W": "(sleeve_width_25 - HW*CAP_K) / (1 - CAP_K)",
  "BACK_NECK_LEN": "2 * length(BACK_NECK)",
  "RIB_FRONT": "length(FRONT_NECK) * rib_front_ratio",
  "RIB_BACK": "BACK_NECK_LEN * rib_back_ratio",
  "RIB_L": "2*RIB_FRONT + RIB_BACK",
  "RIB_H": "2 * rib_width",
  "RIB_IN": "RIB_H * rib_inset",
  "CUFF_L": "cuff",
  "CUFF_H": "2 * cuff_height"
 },

 "points": {
  "HPS": ["NW", 0],
  "SP": ["shoulder_width / 2", "shoulder_drop"],
  "UA": ["CH", "SP.y + sqrt(armhole_depth*armhole_depth - (CH - SP.x)*(CH - SP.x))"],
  "HEM": ["HEM_X", "HEM_Y"],
  "HEM_C": [0, "HEM_Y"],
  "YOKE_C": [0, "YOKE_Y"],
  "YOKE_C_F": [0, "YOKE_Y_F"],
  "V": [0, "V_Y"],
  "VT": [0, "YOKE_Y_F"],
  "VB": {"from": "HPS", "angle": "V_ANG", "dist": "YOKE_Y_F / sin(V_ANG)"},
  "FN_C1": {"from": "VB", "angle": "angle(VB, HPS)", "dist": "dist(VB, HPS) * fn_c1"},
  "FN_C2": {"from": "HPS", "angle": "angle(HPS, SP) + 90", "dist": "fn_c2"},
  "INS_C": [0, "YOKE_Y_F"],
  "INS_T": {"walk": "FRONT_NECK", "s": "length(INS_SIDE)"},
  "INS_TL": ["0 - INS_T.x", "INS_T.y"],
  "INS_B2": ["VB.x", "2 * INS_TOP_Y - YOKE_Y_F"],
  "INS_C2": [0, "2 * INS_TOP_Y - YOKE_Y_F"],
  "BN0": [0, "BND"],
  "BN1": ["neck_c1_x", "BND"],
  "BN2": {"from": "HPS", "angle": "angle(HPS, SP) + 90", "dist": "neck_c2_d"},
  "ARM_C1": {"from": "SP", "angle": "angle(HPS, SP) + ang_shoulder", "dist": "dist(SP, UA) * arm_c1"},
  "ARM_C2": {"from": "UA", "angle": "angle(UA, HEM) + ang_body_underarm", "dist": "dist(SP, UA) * arm_c2"},

  "CAP_TOP": [0, 0],
  "CAP_C1": ["CAP_W * cap_c1", 0],
  "CAP_END": ["CAP_W", "CAP_H"],
  "CAP_C2": {"from": "CAP_END", "angle": "angle(CAP_END, SLV_HEM) + ang_sleeve_underarm", "dist": "dist(CAP_TOP, CAP_END) * cap_c2"},
  "SLV_HEM": ["HW", "SL"],
  "SLV_HEM_C": [0, "SL"],
  "SLV_HEM_Q": ["HW / 2", "SL"],

  "N_ARM_B1": {"walk": "ARM", "reverse": true, "s": "notch_arm_back1 * length(ARM)"},
  "N_ARM_B2": {"walk": "ARM", "reverse": true, "s": "notch_arm_back2 * length(ARM)"},
  "N_ARM_F":  {"walk": "ARM", "reverse": true, "s": "notch_arm_front * length(ARM)"},
  "N_CAP_B1": {"walk": "CAP", "reverse": true, "s": "notch_cap_back1 * TARGET"},
  "N_CAP_B2": {"walk": "CAP", "reverse": true, "s": "notch_cap_back2 * TARGET"},
  "N_CAP_F":  {"walk": "CAP", "reverse": true, "s": "notch_cap_front * TARGET"},

  "RIB_0": [0, 0], "RIB_1": ["RIB_L", 0], "RIB_2": ["RIB_L + RIB_E", "RIB_H / 2"],
  "RIB_3": ["RIB_L", "RIB_H"], "RIB_4": [0, "RIB_H"], "RIB_5": ["0 - RIB_E", "RIB_H / 2"],
  "RIB_N1": ["RIB_FRONT", 0], "RIB_N2": ["RIB_FRONT + RIB_BACK / 2", 0], "RIB_N3": ["RIB_FRONT + RIB_BACK", 0],

  "CUFF_0": [0, 0], "CUFF_1": ["CUFF_L", 0], "CUFF_2": ["CUFF_L", "CUFF_H"], "CUFF_3": [0, "CUFF_H"],
  "CUFF_N1": ["CUFF_L / 4", 0], "CUFF_N2": ["CUFF_L / 2", 0], "CUFF_N3": ["CUFF_L * 3 / 4", 0],
  "CUFF_F0": [0, "CUFF_H / 2"], "CUFF_F1": ["CUFF_L", "CUFF_H / 2"],
  "ARM_Y": {"walk": "ARM", "s": "length(ARM_UP)"},
  "ARM_Y_F": {"walk": "ARM", "s": "length(ARM_UP_F)"}
 },

 "paths": {
  "ARM":       {"bezier": ["SP", "ARM_C1", "ARM_C2", "UA"], "n": 120},
  "ARM_UP":    {"split_y": "ARM", "y": "YOKE_Y", "part": "before"},
  "ARM_LO":    {"split_y": "ARM", "y": "YOKE_Y", "part": "after"},
  "ARM_UP_F":  {"split_y": "ARM", "y": "YOKE_Y_F", "part": "before"},
  "ARM_LO_F":  {"split_y": "ARM", "y": "YOKE_Y_F", "part": "after"},
  "BACK_NECK": {"bezier": ["BN0", "BN1", "BN2", "HPS"], "n": 40},
  "FRONT_NECK": {"bezier": ["VB", "FN_C1", "FN_C2", "HPS"], "n": 40},
  "INS_SIDE":  {"split_y": "FRONT_NECK", "y": "INS_TOP_Y", "part": "before"},
  "CAP":       {"bezier": ["CAP_TOP", "CAP_C1", "CAP_C2", "CAP_END"], "n": 120}
 },

 "measures": {
  "가슴둘레(겨드랑이 바로 위, 앞판+뒤판)": {"girth_at": "UA.y - 0.01", "pieces": ["앞판", "뒤판"]},
  "가슴둘레(겨드랑이 2.5cm 아래)": {"girth_at": "UA.y + 25", "pieces": ["앞판", "뒤판"]},
  "밑단둘레": {"girth_at": "HEM_Y - 0.01", "pieces": ["앞판", "뒤판"]},
  "총길이(뒷목~밑단)": "HEM_Y - BND",
  "어깨넓이": "2 * SP.x",
  "진동 깊이(직선)": "dist(SP, UA)",
  "진동 둘레(반쪽)": "length(ARM)",
  "소매산 둘레(반쪽)": "length(CAP)",
  "소매산 높이": "CAP_H",
  "겨드랑이 소매 둘레": "2 * CAP_W",
  "옆선 길이": "dist(UA, HEM)",
  "소매 밑선 길이": "dist(CAP_END, SLV_HEM)"
 },

 "sewing": {
  "note": "솔기 대조 짝(seam_check.py) — 오른쪽 반만 잰다(왼쪽은 거울). ARM_Y·ARM_Y_F = 진동둘레와 뒤·앞 요크선이 만나는 점",
  "tol_mm": 1.0, "warn_mm": 3.0,
  "ease_note": "소매산 여유는 하키티 재봉선 기준(≈0.995 · 결정 ②) — 진동과 거의 같은 길이, ±5mm 안",
  "seams": [
   {"key": "shoulder", "ko": "어깨", "kind": "equal", "a": [["앞 요크", "HPS", "SP"]], "b": [["뒤 요크", "HPS", "SP"]]},
   {"key": "yoke_front", "ko": "앞 요크선", "kind": "equal", "a": [["앞 요크", "ARM_Y_F", "VB"]], "b": [["앞판", "@VB", "@ARM_Y_F"]]},
   {"key": "rib_end", "ko": "넥 립 끝 ↔ 앞 이음선", "kind": "equal", "same_sa": false, "a": [["넥 립", "RIB_5", "RIB_0"]], "b": [["앞판", "YOKE_C_F", "@VB"]]},
   {"key": "insert_bottom", "ko": "V 인서트 아래 ↔ 앞 이음선", "kind": "equal", "a": [["V 인서트", "INS_C", "VB"]], "b": [["앞판", "YOKE_C_F", "@VB"]]},
   {"key": "insert_side", "ko": "V 인서트 옆 ↔ 앞 요크 V선", "kind": "equal", "a": [["V 인서트", "VB", "INS_T"]], "b": [["앞 요크", "VB", "@INS_T"]]},
   {"key": "yoke_back", "ko": "뒤 요크선", "kind": "equal", "a": [["뒤 요크", "@ARM_Y", "YOKE_C"]], "b": [["뒤판", "YOKE_C", "@ARM_Y"]]},
   {"key": "side", "ko": "옆선", "kind": "equal", "a": [["앞판", "UA", "HEM"]], "b": [["뒤판", "UA", "HEM"]]},
   {"key": "armhole_front", "ko": "진동 ↔ 소매산(앞)", "kind": "ease", "min": -5, "max": 5, "notch_tol": 5,
    "a": [["앞 요크", "SP", "ARM_Y_F"], ["앞판", "@ARM_Y_F", "UA"]], "b": [["소매", "CAP_TOP", "CAP_END"]], "notches": [["N_ARM_F", "N_CAP_F"]]},
   {"key": "armhole_back", "ko": "진동 ↔ 소매산(뒤)", "kind": "ease", "min": -5, "max": 5, "notch_tol": 5,
    "a": [["뒤 요크", "SP", "@ARM_Y"], ["뒤판", "@ARM_Y", "UA"]], "b": [["소매", "CAP_TOP", "CAP_END_L", "rev"]],
    "notches": [["N_ARM_B1", "N_CAP_B1"], ["N_ARM_B2", "N_CAP_B2"]]},
   {"key": "underarm", "ko": "소매 밑선", "kind": "equal", "a": [["소매", "CAP_END", "SLV_HEM"]], "b": [["소매", "CAP_END_L", "SLV_HEM_L", "rev"]]},
   {"key": "cuff", "ko": "소매 끝 ↔ 커프스", "kind": "ratio", "min": 0.4, "max": 1.0, "same_sa": false,
    "a": [["소매", "SLV_HEM", "SLV_HEM_L"]], "b": [["커프스", "CUFF_0", "CUFF_1"]]},
   {"key": "neck_front", "ko": "앞 목 ↔ 넥 립", "kind": "ratio", "min": 0.75, "max": 1.0, "same_sa": false,
    "a": [["앞 요크", "VB", "HPS"]], "b": [["넥 립", "RIB_0", "@RIB_N1"]]},
   {"key": "neck_back", "ko": "뒷목 ↔ 넥 립", "kind": "ratio", "min": 0.75, "max": 1.0, "same_sa": false,
    "a": [["뒤 요크", "HPS", "BN0", "rev"], ["뒤 요크", "BN0", "HPS_L", "rev"]], "b": [["넥 립", "@RIB_N1", "@RIB_N3"]]}
  ]
 },
 "pieces": {
  "뒤 요크": {"en_name": "BACK YOKE", "qty": 1, "grain": "세로", "mirror_x": true,
            "outline": ["BN0", "BACK_NECK", "HPS", "SP", "ARM_UP", "YOKE_C"],
            "notches": [{"at": "BN0"}, {"at": "YOKE_C"}]},
  "뒤판": {"en_name": "BACK BODY", "qty": 1, "grain": "세로", "mirror_x": true,
          "outline": ["YOKE_C", "ARM_LO", "UA", {"ref": "HEM", "sa": "hem_sa"}, "HEM_C"],
          "notches": [{"at": "N_ARM_B1", "side": "both"}, {"at": "N_ARM_B2", "side": "both"}, {"at": "YOKE_C"}]},
  "앞판": {"en_name": "FRONT BODY", "qty": 1, "grain": "세로", "mirror_x": true,
          "outline": ["YOKE_C_F", "ARM_LO_F", "UA", {"ref": "HEM", "sa": "hem_sa"}, "HEM_C"],
          "notches": [{"at": "N_ARM_F", "side": "both"}, {"at": "YOKE_C_F"}, {"at": "VB", "side": "both"}]},
  "앞 요크": {"en_name": "FRONT YOKE", "qty": 2, "grain": "세로", "note": "좌우 2장 — V 가 앞 이음선까지 트여 둘로 나뉜다(결정 ③). 1장은 뒤집어 재단",
            "outline": ["VB", "FRONT_NECK", "HPS", "SP", "ARM_UP_F", "ARM_Y_F"],
            "notches": [{"at": "INS_T"}]},
  "V 인서트": {"en_name": "V INSERT", "qty": 1, "grain": "세로", "mirror_x": true,
             "note": "2겹 — 윗변에서 접음 · 립 안쪽에 대고 양옆은 V 봉제선, 아래는 앞 이음선에 같이 박는다(결정 ①) · 몸판과 같은 원단",
             "outline": ["INS_C", "VB", "INS_T", "INS_B2", "INS_C2"], "fold": ["INS_TL", "INS_T"],
             "notches": [{"at": "INS_C"}]},
  "소매": {"en_name": "SLEEVE", "qty": 2, "grain": "세로", "mirror_x": true, "note": "오른쪽(x>0) = 앞, 왼쪽 = 뒤",
          "outline": ["CAP_TOP", "CAP", "CAP_END", "SLV_HEM", "SLV_HEM_C"],
          "notches": [{"at": "N_CAP_B1", "side": "left"}, {"at": "N_CAP_B2", "side": "left"}, {"at": "N_CAP_F", "side": "right"},
                      {"at": "CAP_TOP"}, {"at": "SLV_HEM_C"}, {"at": "SLV_HEM_Q", "side": "both"}]},
  "넥 립": {"en_name": "NECK RIB", "qty": 1, "grain": "세로(립 골 세로 · 늘어나는 방향 가로)", "note": "2겹 — 가운데에서 접음 · 두 끝은 앞 이음선에 가로로 물린다(접힌 쪽이 RIB_E 만큼 길다)",
          "outline": ["RIB_0", "RIB_1", "RIB_2", "RIB_3", "RIB_4", "RIB_5"],
          "notches": [{"at": "RIB_N1"}, {"at": "RIB_N2"}, {"at": "RIB_N3"}], "fold": ["RIB_5", "RIB_2"]},
  "커프스": {"en_name": "CUFF", "qty": 2, "grain": "세로(립 골 세로 · 늘어나는 방향 가로)", "note": "2겹 — 가운데에서 접음",
           "outline": ["CUFF_0", "CUFF_1", "CUFF_2", "CUFF_3"],
           "notches": [{"at": "CUFF_N1"}, {"at": "CUFF_N2"}, {"at": "CUFF_N3"}], "fold": ["CUFF_F0", "CUFF_F1"]}
 }
}
